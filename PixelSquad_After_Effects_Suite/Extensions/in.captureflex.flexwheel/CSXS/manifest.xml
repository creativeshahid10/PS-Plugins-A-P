<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="in.captureflex.flexwheel" ExtensionBundleVersion="3.0.0"
                   ExtensionBundleName="PixelSquad Wheel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="in.captureflex.flexwheel.bg" Version="3.0.0" />
    <Extension Id="in.captureflex.flexwheel.panel" Version="3.0.0" />
    <Extension Id="in.captureflex.flexwheel.settings" Version="3.0.0" />
    <Extension Id="in.captureflex.flexwheel.search" Version="3.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[18.0,99.9]" />
      <Host Name="PPRO" Version="[15.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="in.captureflex.flexwheel.bg">
      <DispatchInfo>
        <Resources>
          <MainPath>./bg.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="in.captureflex.flexwheel.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PixelSquad Wheel</Menu>
          <Geometry>
            <Size><Height>220</Height><Width>300</Width></Size>
            <MinSize><Height>160</Height><Width>220</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="in.captureflex.flexwheel.settings">
      <DispatchInfo>
        <Resources>
          <MainPath>./ui.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Geometry>
            <Size><Height>700</Height><Width>1080</Width></Size>
            <MinSize><Height>600</Height><Width>940</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>3840</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="in.captureflex.flexwheel.search">
      <DispatchInfo>
        <Resources>
          <MainPath>./ui.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Geometry>
            <Size><Height>420</Height><Width>520</Width></Size>
            <MinSize><Height>320</Height><Width>420</Width></MinSize>
            <MaxSize><Height>900</Height><Width>900</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
