<ExtensionManifest Version="7.0" ExtensionBundleId="com.pixelsquad.pscaptions" ExtensionBundleVersion="1.0.0" ExtensionBundleName="PixelSquad Captions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    Author="Mohammed Shahid" Contact="hello@pixelsquad.in"
    LegalCopyright="Copyright (C) 2026 PixelSquad. All Rights Reserved.">
  <ExtensionList>
    <Extension Id="com.pixelsquad.pscaptions" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="7.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.pixelsquad.pscaptions">
      <DispatchInfo>
        <Resources>
          <MainPath>./html/index.html</MainPath>
          <ScriptPath>./jsx/PremiereCaptionEngine.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-web-security</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PixelSquad Captions</Menu>
          <Geometry>
            <Size>
              <Height>650</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>450</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
  <AccessList>
    <Access href="http://*"/>
    <Access href="https://*"/>
  </AccessList>
</ExtensionManifest>
